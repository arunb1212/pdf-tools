{
  "name": "pdf-tools-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Zero-data-retention PDF microservice (Fastify + gs/qpdf/poppler/tesseract)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.1",
    "archiver": "^7.0.1",
    "csv-parse": "^5.6.0",
    "fastify": "^4.28.1",
    "pdf-lib": "^1.17.1",
    "pdf-lib-with-encrypt": "^1.2.1"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.6.0"
  }
}
