# Public site URL used for sitemap/canonical/hreflang URLs (no trailing slash).
# Change to your real domain before deploying.
SITE_URL=https://pdf-tools.example.com

# Zero-retention PDF microservice (server/). Empty = client-side only.
# Local: PUBLIC_PDF_API_URL=http://localhost:8080
# Prod:  PUBLIC_PDF_API_URL=https://your-pdf-api.onrender.com
PUBLIC_PDF_API_URL=http://localhost:8080
