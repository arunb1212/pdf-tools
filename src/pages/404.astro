---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ui, defaultLocale } from "../i18n/ui";

const t = ui[defaultLocale];
const path = "/404/";
---

<BaseLayout
  locale={defaultLocale}
  title={`${t.notFoundTitle} — ${t.siteName}`}
  description={t.notFoundBody}
  path={path}
  alternates={[{ locale: "en", path: "/" }]}
  noindex
>
  <Header locale={defaultLocale} />

  <main id="main-content">
    <script is:inline>
      (function() {
        try {
          var trimmed = window.location.pathname.replace(/^\/|\/$/g, '');
          var germanSlugs = {
            'pdf-zusammenfuegen': '/de/pdf-zusammenfuegen/',
            'pdf-teilen': '/de/pdf-teilen/',
            'pdf-sperren': '/de/pdf-sperren/',
            'pdf-entsperren': '/de/pdf-entsperren/',
            'pdf-zu-jpg': '/de/pdf-zu-jpg/',
            'jpg-zu-pdf': '/de/jpg-zu-pdf/',
            'csv-zu-pdf': '/de/csv-zu-pdf/',
            'pdf-zu-csv': '/de/pdf-zu-csv/',
            'jpg-zu-csv': '/de/jpg-zu-csv/',
            'pdf-daten-schwaerzen': '/de/pdf-daten-schwaerzen/',
            'pdf-signieren': '/de/pdf-signieren/'
          };
          if (germanSlugs[trimmed]) {
            window.location.replace(germanSlugs[trimmed]);
          }
        } catch (e) {}
      })();
    </script>
    <div class="container notfound">
      <h1>{t.notFoundTitle}</h1>
      <p>{t.notFoundBody}</p>
      <a class="btn btn--primary" href="/">{t.notFoundHome}</a>
    </div>
  </main>

  <Footer locale={defaultLocale} />
</BaseLayout>

<style>
  .notfound {
    text-align: center;
    padding: 5rem 0;
  }
  .notfound p {
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }
</style>
