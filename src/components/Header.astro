---
import { ui, type Locale } from "../i18n/ui";
import { getTool } from "../data/tools";
import LanguageSwitcher from "./react/LanguageSwitcher.tsx";

interface Props {
  locale: Locale;
  /** Map of locale -> equivalent path so the switcher keeps you on-page. */
  languagePaths?: Record<Locale, string>;
}

const { locale, languagePaths } = Astro.props;
const t = ui[locale];

const navTools = [
  getTool("merge-pdf")!.id,
  getTool("split-pdf")!.id,
  getTool("pdf-to-jpg")!.id,
  getTool("jpg-to-pdf")!.id,
  getTool("lock-pdf")!.id,
  getTool("unlock-pdf")!.id,
];

const langOptions = [
  { locale: "en", label: "English", nativeLabel: "English", flag: "🇬🇧" },
  { locale: "de", label: "German", nativeLabel: "Deutsch", flag: "🇩🇪" },
];

function toolPath(id: string) {
  const tool = getTool(id)!;
  return `/${tool.slug[locale]}/`;
}

// Fallback paths (home) if the parent doesn't pass languagePaths.
const defaultPaths = {
  en: "/",
  de: "/de/",
};
const switcherPaths = languagePaths
  ? (languagePaths as Record<string, string>)
  : (defaultPaths as Record<string, string>);
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href={`/`}>
      <span class="site-header__logo" aria-hidden="true">📄</span>
      <span class="site-header__name">{t.siteName}</span>
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      <a href={`/`}>{t.navHome}</a>
      <a href={`/features/`}>{t.navFeatures}</a>
      <a href={`/#tools`}>{t.navTools}</a>
      <a href={locale === "en" ? "/about/" : "/de/about/"}>{t.navAbout}</a>
      <a href={`/privacy/`}>{t.navPrivacy}</a>
    </nav>

    <LanguageSwitcher client:load current={locale} paths={switcherPaths} options={langOptions} />
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: saturate(180%) blur(6px);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 62px;
  }
  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    color: var(--color-text);
    text-decoration: none;
    margin-right: auto;
  }
  .site-header__logo {
    font-size: 1.25rem;
  }
  .site-header__nav {
    display: flex;
    gap: 1.25rem;
  }
  .site-header__nav a {
    color: var(--color-text-muted);
    font-weight: 500;
  }
  .site-header__nav a:hover {
    color: var(--color-text);
    text-decoration: none;
  }

  /* Language drop-down (React island) */
  .lang-switcher {
    position: relative;
  }
  .lang-switcher__trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    cursor: pointer;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-text);
    transition: border-color 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
  }
  .lang-switcher__trigger:hover {
    border-color: var(--color-accent);
    background: var(--color-bg);
    box-shadow: var(--shadow-sm);
  }
  .lang-switcher__flag {
    font-size: 1.05rem;
    line-height: 1;
  }
  .lang-switcher__code {
    letter-spacing: 0.03em;
  }
  .lang-switcher__caret {
    color: var(--color-text-muted);
  }
  .lang-switcher__trigger[aria-expanded="true"] .lang-switcher__caret {
    transform: rotate(180deg);
  }
  .lang-switcher__menu {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    min-width: 210px;
    margin: 0;
    padding: 0.4rem;
    list-style: none;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    z-index: 200;
    animation: lang-menu-in 0.15s ease;
  }
  @keyframes lang-menu-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .lang-switcher__item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.7rem;
    border-radius: var(--radius-sm);
    color: var(--color-text);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .lang-switcher__item:hover {
    background: var(--color-surface);
    text-decoration: none;
  }
  .lang-switcher__item.is-highlighted {
    background: var(--color-surface);
  }
  .lang-switcher__item.is-active {
    color: var(--color-accent);
    font-weight: 700;
  }
  .lang-switcher__label {
    font-weight: 500;
  }
  .lang-switcher__native {
    margin-left: auto;
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }
  .lang-switcher__check {
    color: var(--color-accent);
    flex: none;
  }

  @media (max-width: 640px) {
    .site-header__nav {
      gap: 0.9rem;
    }
    /* Keep fewer top-level links on mobile; about + privacy live in footer. */
    .site-header__nav a[href="/privacy/"],
    .site-header__nav a[href$="/privacy/"],
    .site-header__nav a[href="/about/"],
    .site-header__nav a[href$="/about/"] {
      display: none;
    }
  }
</style>
