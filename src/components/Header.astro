---
import { ui, type Locale } from "../i18n/ui";
import { getTool, getToolUrl } from "../data/tools";
import LanguageSwitcher from "./react/LanguageSwitcher.tsx";

interface Props {
  locale: Locale;
  /** Map of locale -> equivalent path so the switcher keeps you on-page. */
  languagePaths?: Record<Locale, string>;
}

const { locale, languagePaths } = Astro.props;
const t = ui[locale];

const navTools = [
  getTool("merge-pdf")!.id,
  getTool("split-pdf")!.id,
  getTool("pdf-to-jpg")!.id,
  getTool("jpg-to-pdf")!.id,
  getTool("lock-pdf")!.id,
  getTool("unlock-pdf")!.id,
];

const langOptions = [
  { locale: "en", label: "English", nativeLabel: "English", flag: "🇬🇧" },
  { locale: "de", label: "German", nativeLabel: "Deutsch", flag: "🇩🇪" },
];

function toolPath(id: string) {
  const tool = getTool(id)!;
  return getToolUrl(tool, locale);
}

// Fallback paths (home) if the parent doesn't pass languagePaths.
const defaultPaths = {
  en: "/",
  de: "/de/",
};
const switcherPaths = languagePaths
  ? (languagePaths as Record<string, string>)
  : (defaultPaths as Record<string, string>);
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href={locale === "en" ? "/" : "/de/"}>
      <span class="site-header__logo" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
          <polyline points="14 2 14 8 20 8" />
          <line x1="16" y1="13" x2="8" y2="13" />
          <line x1="16" y1="17" x2="8" y2="17" />
          <polyline points="10 9 9 9 8 9" />
        </svg>
      </span>
      <span class="site-header__name">{t.siteName}</span>
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      <a href={locale === "en" ? "/" : "/de/"}>{t.navHome}</a>
      <a href={locale === "en" ? "/editor/" : "/de/editor/"}>PDF Studio</a>
      <a href={locale === "en" ? "/features/" : "/de/features/"}>{t.navFeatures}</a>
      <a href={locale === "en" ? "/#tools" : "/de/#tools"}>{t.navTools}</a>
      <a href={locale === "en" ? "/about/" : "/de/about/"}>{t.navAbout}</a>
      <a href={locale === "en" ? "/privacy/" : "/de/privacy/"}>{t.navPrivacy}</a>
    </nav>

    <LanguageSwitcher client:load current={locale} paths={switcherPaths} options={langOptions} />
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: saturate(180%) blur(6px);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 62px;
  }
  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    color: var(--color-text);
    text-decoration: none;
    margin-right: auto;
  }
  .site-header__logo {
    font-size: 1.25rem;
  }
  .site-header__nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .site-header__nav a {
    color: var(--color-text-muted);
    font-weight: 500;
    font-size: 0.95rem;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .site-header__nav a:hover {
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    .site-header__nav {
      gap: 0.9rem;
    }
    /* Keep fewer top-level links on mobile; about + privacy live in footer. */
    .site-header__nav a[href="/privacy/"],
    .site-header__nav a[href$="/privacy/"],
    .site-header__nav a[href="/about/"],
    .site-header__nav a[href$="/about/"] {
      display: none;
    }
  }
</style>

<style is:global>
  /* Language drop-down (React island) */
  .lang-switcher {
    position: relative;
    display: inline-flex;
    align-items: center;
  }
  .lang-switcher__trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    cursor: pointer;
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--color-text);
    line-height: 1;
    transition: border-color 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
    user-select: none;
  }
  .lang-switcher__trigger:hover {
    border-color: var(--color-accent);
    background: var(--color-bg);
    box-shadow: var(--shadow-sm);
  }
  .lang-switcher__flag {
    font-size: 1.1rem;
    line-height: 1;
    display: inline-flex;
    align-items: center;
  }
  .lang-switcher__code {
    letter-spacing: 0.04em;
    font-weight: 600;
    font-size: 0.85rem;
  }
  .lang-switcher__caret {
    color: var(--color-text-muted);
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }
  .lang-switcher__trigger[aria-expanded="true"] .lang-switcher__caret {
    transform: rotate(180deg);
  }
  .lang-switcher__menu {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    min-width: 200px;
    margin: 0;
    padding: 0.35rem;
    list-style: none;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    z-index: 200;
    animation: lang-menu-in 0.15s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .lang-switcher__menu li {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @keyframes lang-menu-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .lang-switcher__item {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.55rem 0.75rem;
    border-radius: var(--radius-sm);
    color: var(--color-text);
    text-decoration: none;
    font-size: 0.9rem;
    transition: background 0.12s ease, color 0.12s ease;
    cursor: pointer;
  }
  .lang-switcher__item:hover,
  .lang-switcher__item.is-highlighted {
    background: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
  }
  .lang-switcher__item.is-active {
    color: var(--color-accent);
    font-weight: 600;
  }
  .lang-switcher__label {
    font-weight: 500;
  }
  .lang-switcher__native {
    margin-left: auto;
    color: var(--color-text-muted);
    font-size: 0.8rem;
    font-weight: 400;
  }
  .lang-switcher__item.is-active .lang-switcher__native {
    color: var(--color-accent);
    opacity: 0.85;
  }
  .lang-switcher__check {
    color: var(--color-accent);
    flex: none;
    margin-left: 0.35rem;
  }
</style>
