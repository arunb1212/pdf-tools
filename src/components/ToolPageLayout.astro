---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import { ui, locales, type Locale } from "../i18n/ui";
import { getTool, getRelatedToolIds, getToolUrl } from "../data/tools";

import MergePdf from "./react/MergePdf.tsx";
import SplitPdf from "./react/SplitPdf.tsx";
import LockPdf from "./react/LockPdf.tsx";
import UnlockPdf from "./react/UnlockPdf.tsx";
import PdfToJpg from "./react/PdfToJpg.tsx";
import JpgToPdf from "./react/JpgToPdf.tsx";
import CsvToPdf from "./react/CsvToPdf.tsx";
import PdfToCsv from "./react/PdfToCsv.tsx";
import JpgToCsv from "./react/JpgToCsv.tsx";
import HideDataOnPdf from "./react/HideDataOnPdf.tsx";
import SignPdf from "./react/SignPdf.tsx";
import FillFormPdf from "./react/FillFormPdf.tsx";
import CompressPdf from "./react/CompressPdf.tsx";

interface Props {
  entry: CollectionEntry<"tools">;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const { data } = entry;
const t = ui[locale];
const toolDef = getTool(data.tool)!;
const site = Astro.site!;

const alternates = locales.map((l) => ({
  locale: l,
  path: getToolUrl(toolDef, l),
}));

const path = getToolUrl(toolDef, locale);
const title = data.title;
const description = data.description;

// Language switcher keeps the user on the same tool in another language.
const languagePaths = {
  en: getToolUrl(toolDef, "en"),
  de: getToolUrl(toolDef, "de"),
};

const messages = {
  dragDrop: t.dragDrop,
  browse: t.browse,
  chooseFiles: t.chooseFiles,
  unsupportedFile: t.unsupportedFile,
  processing: t.processing,
  download: t.download,
  processAnother: t.processAnother,
  errorGeneric: t.errorGeneric,
  legalNote: t.legalNote,
  ocrNote: t.ocrNote,
  ocrNoteServer: t.ocrNoteServer,
  mergeAction: t.mergeAction,
  splitAction: t.splitAction,
  lockAction: t.lockAction,
  unlockAction: t.unlockAction,
  pdfToJpgAction: t.pdfToJpgAction,
  jpgToPdfAction: t.jpgToPdfAction,
  pdfToCsvAction: t.pdfToCsvAction,
  csvToPdfAction: t.csvToPdfAction,
  needTwoFiles: t.needTwoFiles,
  errorPassword: t.errorPassword,
  errorNoText: t.errorNoText,
  passwordMismatch: t.passwordMismatch,
  passwordLabel: t.passwordLabel,
  confirmPasswordLabel: t.confirmPasswordLabel,
  columnsLabel: t.columnsLabel,
  rowsLabel: t.rowsLabel,
  reorderHint: t.reorderHint,
  viaServer: t.viaServer,
  doneSplitOne: t.doneSplitOne,
  doneSplitMany: t.doneSplitMany,
  doneSplitPages: t.doneSplitPages,
  doneLocked: t.doneLocked,
  doneUnlocked: t.doneUnlocked,
  doneImages: t.doneImages,
  imageUnit: t.imageUnit,
  doneRows: t.doneRows,
  doneOcr: t.doneOcr,
  doneTable: t.doneTable,
  doneCompressed: t.doneCompressed,
  doneOptimal: t.doneOptimal,
  doneSigned: t.doneSigned,
  doneRedacted: t.doneRedacted,
  doneFormFilled: t.doneFormFilled,
  trustLineServer: t.trustLineServer,
  badgeServer: t.badgeServer,
  doneSignedMany: t.doneSignedMany,
  jumpLabel: t.jumpLabel,
  jumpGo: t.jumpGo,
  rotationLabel: t.rotationLabel,
  signHintMulti: t.signHintMulti,
};

const related = getRelatedToolIds(toolDef).map((id) => getTool(id)!);

const softwareSchema = {
  "@type": "SoftwareApplication",
  name: data.shortTitle,
  description: data.description,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Web",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  url: new URL(path, site).href,
};

const faqSchema = data.faq
  ? {
      "@type": "FAQPage",
      mainEntity: data.faq.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    }
  : null;

// Breadcrumb: Home → Tools → this tool.
const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: t.navHome, item: new URL(locale === "en" ? "/" : "/de/", site).href },
    { "@type": "ListItem", position: 2, name: t.toolsSectionTitle, item: new URL(locale === "en" ? "/#tools" : "/de/#tools", site).href },
    { "@type": "ListItem", position: 3, name: data.shortTitle, item: new URL(path, site).href },
  ],
};

const jsonLd = faqSchema
  ? [softwareSchema, faqSchema, breadcrumbSchema]
  : [softwareSchema, breadcrumbSchema];

const isBuilt = [
  "MergePdf",
  "SplitPdf",
  "LockPdf",
  "UnlockPdf",
  "PdfToJpg",
  "JpgToPdf",
  "CsvToPdf",
  "PdfToCsv",
  "JpgToCsv",
  "HideDataOnPdf",
  "SignPdf",
  "FillFormPdf",
  "CompressPdf",
].includes(data.component);

const isWideTool = ["FillFormPdf", "SignPdf", "HideDataOnPdf"].includes(data.component);

// Baked at build time: when the API URL is set, client tools run
// server-first, so the badge + trust line must not claim "no upload".
const serverConfigured =
  ((import.meta.env.PUBLIC_PDF_API_URL as string | undefined) ?? "").trim() !== "";
// FillFormPdf never uploads (visual annotations are baked in-browser).
const mayUpload = serverConfigured && data.component !== "FillFormPdf";
const badgeText =
  serverConfigured && data.processing === "client"
    ? t.badgeServer
    : data.processing === "client"
      ? t.fullyClientSide
      : t.serverFallback;
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  path={path}
  alternates={alternates}
  jsonLd={jsonLd}
>
  <Header locale={locale} languagePaths={languagePaths} />

  <main id="main-content">
    <article class:list={["container", "tool-page", { "tool-page--wide": isWideTool }]}>
      <!-- Visible Breadcrumb Navigation -->
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol class="breadcrumbs__list">
          <li><a href={locale === "en" ? "/" : "/de/"}>{t.navHome}</a></li>
          <li><span aria-hidden="true">›</span><a href={locale === "en" ? "/#tools" : "/de/#tools"}>{t.toolsSectionTitle}</a></li>
          <li><span aria-hidden="true">›</span><span aria-current="page">{data.shortTitle}</span></li>
        </ol>
      </nav>
      <header class="tool-page__header">
        <span class="tool-badge" data-processing={data.processing}>
          {badgeText}
        </span>
        <h1>{data.shortTitle}</h1>
        <p class="tool-page__tagline">{data.description}</p>
      </header>

      <section class="widget" aria-label={data.shortTitle}>
        {
          isBuilt ? (
            <>
              {data.component === "MergePdf" && <MergePdf client:visible messages={messages} />}
              {data.component === "SplitPdf" && <SplitPdf client:visible messages={messages} />}
              {data.component === "LockPdf" && <LockPdf client:visible messages={messages} />}
              {data.component === "UnlockPdf" && <UnlockPdf client:visible messages={messages} />}
              {data.component === "PdfToJpg" && <PdfToJpg client:visible messages={messages} />}
              {data.component === "JpgToPdf" && <JpgToPdf client:visible messages={messages} />}
              {data.component === "CsvToPdf" && <CsvToPdf client:visible messages={messages} />}
              {data.component === "PdfToCsv" && <PdfToCsv client:visible messages={messages} />}
              {data.component === "JpgToCsv" && <JpgToCsv client:visible messages={messages} />}
              {data.component === "HideDataOnPdf" && <HideDataOnPdf client:visible messages={messages} />}
              {data.component === "SignPdf" && <SignPdf client:visible messages={messages} />}
              {data.component === "FillFormPdf" && <FillFormPdf client:visible messages={messages} locale={locale} />}
              {data.component === "CompressPdf" && <CompressPdf client:visible messages={messages} />}
            </>
          ) : (
            <p class="coming-soon">{t.unsupportedFile}</p>
          )
        }
        {data.processing === "client" && (
          <p class="trust-line">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align: -2px; margin-right: 4px;">
              <rect x="3" y="11" width="18" height="11" rx="2" />
              <path d="M7 11V7a5 5 0 0 1 10 0v4" />
            </svg>
            {mayUpload ? t.trustLineServer : t.trustLine}
          </p>
        )}
      </section>

      <div class="tool-page__body">
        <h2>{t.howToTitle}</h2>
        <div class="tool-content__body">
          {data.steps.length > 0 ? (
            <ol class="howto-steps">
              {data.steps.map((step) => (
                <li>{step}</li>
              ))}
            </ol>
          ) : (
            <p>{data.description}</p>
          )}
        </div>

        {data.faq && (
          <section class="faq" aria-labelledby="faq-heading">
            <h2 id="faq-heading">{t.faqTitle}</h2>
            {data.faq.map((item) => (
              <details>
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))}
          </section>
        )}
      </div>

      <aside class="related" aria-label={t.relatedTools}>
        <h2>{t.relatedTools}</h2>
        <ul>
          {related.map((r) => (
            <li>
              <a href={getToolUrl(r, locale)}>
                <strong>{r.label[locale]}</strong>
                <span>{r.summary[locale]}</span>
              </a>
            </li>
          ))}
        </ul>
      </aside>
    </article>
  </main>

  <Footer locale={locale} />
</BaseLayout>
